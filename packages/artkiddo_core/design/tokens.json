{
  "$schema-note": "Single source of truth for ArtKiddo design tokens. app_tokens.dart is checked against it by test/unit/presentation/design_tokens_test.dart; a sibling web client copies it to generate its own stylesheet. A value written as {name} is an alias of another colour.",
  "version": 2,
  "color": {
    "paper": "#F7F2EA",
    "surface": "#FFFDFC",
    "surface-sunken": "#F0E8DE",
    "ink": "#27221D",
    "ink-muted": "#625A51",
    "ink-disabled": "#8A8178",
    "accent": "#A84732",
    "accent-pressed": "#823727",
    "accent-surface": "#F6ECE9",
    "on-accent": "#FFFFFF",
    "share": "#315F95",
    "share-pressed": "#254A76",
    "share-surface": "#E9EFF7",
    "sage-surface": "#E6EEE6",
    "sage-ink": "#4C6B55",
    "lavender-surface": "#F0EBF6",
    "lavender-ink": "#59476F",
    "ochre": "#D49A28",
    "ochre-surface": "#F6EBD0",
    "ochre-ink": "#7A5410",
    "border": "#DED4C8",
    "border-strong": "#928372",
    "danger": "#B33B32",
    "danger-surface": "#F7E7E4",
    "success": "{sage-ink}",
    "success-surface": "{sage-surface}",
    "warning": "#8A5A00",
    "warning-surface": "#FBF0DC",
    "overlay": "#27221D7A",
    "immersive": "#1D1915",
    "focus-ring": "{accent}",
    "disabled-bg": "#FFFFFF00",
    "scrim-soft": "#27221D1F",
    "scrim": "#27221D33",
    "scrim-strong": "#27221D66"
  },
  "child": [
    { "surface": "{accent-surface}", "ink": "{accent-pressed}" },
    { "surface": "{share-surface}", "ink": "{share-pressed}" },
    { "surface": "{sage-surface}", "ink": "{sage-ink}" },
    { "surface": "{lavender-surface}", "ink": "{lavender-ink}" },
    { "surface": "{ochre-surface}", "ink": "{ochre-ink}" }
  ],
  "space": { "s1": 4, "s2": 8, "s3": 12, "s4": 16, "s5": 20, "s6": 24, "s8": 32, "s10": 40, "s12": 48, "s16": 64 },
  "radius": { "xs": 4, "artwork": 10, "sm": 14, "md": 20, "lg": 28, "full": 999 },
  "shadow": {
    "sm": { "y": 4, "blur": 12, "color": "#27221D14" },
    "lg": { "y": 12, "blur": 32, "color": "#27221D1F" }
  },
  "size": { "button": 52, "button-text": 48, "chip": 40, "avatar": 44, "avatar-small": 36, "badge": 26, "banner": 44, "shutter": 72, "fab-clearance": 104, "tap-target": 48 },
  "duration": { "micro": 150, "standard": 200, "page": 280, "pulse": 800, "linger": 1000, "highlight": 1200, "snack-bar": 4000, "snack-bar-long": 8000 },
  "font": {
    "family": "Playpen Sans",
    "mono": ["Menlo", "Courier", "monospace"]
  },
  "type": {
    "display":     { "size": 32, "line": 36, "weight": 600, "tracking": -0.35 },
    "h1":          { "size": 28, "line": 34, "weight": 600, "tracking": -0.2 },
    "h2":          { "size": 22, "line": 28, "weight": 600, "tracking": -0.1 },
    "h3":          { "size": 18, "line": 24, "weight": 600, "tracking": 0 },
    "body-large":  { "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "body":        { "size": 15, "line": 22, "weight": 400, "tracking": 0 },
    "body-strong": { "size": 15, "line": 22, "weight": 600, "tracking": 0 },
    "label":       { "size": 13, "line": 18, "weight": 600, "tracking": 0.1 },
    "caption":     { "size": 13, "line": 18, "weight": 400, "tracking": 0.1 },
    "button":      { "size": 15, "line": 20, "weight": 700, "tracking": 0 },
    "mono":        { "size": 14, "line": 20, "weight": 400, "tracking": 0, "family": "mono" },
    "code":        { "size": 28, "line": 36, "weight": 700, "tracking": 4, "family": "mono" }
  }
}
